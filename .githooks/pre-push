#!/bin/bash
#
# Pre-push hook: secret scan (gitleaks), then the checks that finish in
# seconds (fmt, build). Install with: task hooks:install
#
# Lint, vulncheck and the race tests are deliberately NOT here. git opens the
# connection to the remote before it runs this hook and only sends the pack
# afterwards; with the full `task all` in between, the session sat idle for
# minutes and GitHub closed it, so every push ended in "send-pack: unexpected
# disconnect while reading sideband packet" right after the checks passed
# (2026-10-12, reproduced over ssh and https). A hook that cannot let a push
# through is no check at all. CI runs the same lint, vulncheck and tests on
# every push and PR; `task all` is still there to run them by hand.
#
# Pushes that only delete remote branches carry no new code, so the checks
# are skipped for them. Git reports a deletion as an all-zeros local sha on
# stdin: "<local ref> <local sha> <remote ref> <remote sha>".

set -e

zero=$(printf '0%.0s' {1..40})
has_update=false
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    if [ "$local_sha" != "$zero" ]; then
        has_update=true
    fi
done

if [ "$has_update" = false ]; then
    echo "Push contains only deletions; skipping pre-push checks."
    exit 0
fi

echo "Running pre-push checks..."

if ! command -v task &> /dev/null; then
    echo "Error: 'task' is not installed."
    echo "Please install Task from https://taskfile.dev/installation/"
    exit 1
fi

# Secret scan first -- it is cheap (~300ms over full history) and a leak should
# fail fast, before the slow build/lint/test pass. Warn-and-skip if gitleaks is
# absent (not a Go-toolchain default); install it with: task install:deps
if command -v gitleaks &> /dev/null; then
    echo "Scanning history for secrets (gitleaks)..."
    task secrets
else
    echo "WARNING: gitleaks not found; skipping the history secret scan."
    echo "  Install it with: task install:deps"
fi

task fmt
task build

echo "All pre-push checks passed!"
