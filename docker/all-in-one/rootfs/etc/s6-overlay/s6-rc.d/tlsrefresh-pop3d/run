#!/command/with-contenv sh
# Re-stage pop3d's TLS material into /run/tls/pop3d when the source files
# change (certbot drops renewed certs into the read-only /etc/letsencrypt
# mount). pop3d's run script does the initial stage itself before exec, so
# pop3d never starts without its certs; this service only keeps the staged
# copies current. Handlers load the cert fresh per connection, so a restage
# is picked up immediately without restarting pop3d.
exec /tlsstage -config /etc/infodancer/config.toml -section pop3d -out /run/tls/pop3d -refresh 1h
